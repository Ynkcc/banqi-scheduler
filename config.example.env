# server/config.example.env — Go 调度器示例配置
#
# 用法：
#   cp config.example.env config.env   # 按需修改，config.env 不要提交
#   set -a; source config.env; set +a
#   ./scheduler
#
# 或 systemd：EnvironmentFile=/etc/banqi/scheduler.env（格式相同）

# ── 监听与元数据 ────────────────────────────────────────────────────────────
# gRPC 监听地址
SCHEDULER_LISTEN=:50051
# SQLite 数据库路径（networks / matches / episodes / workers）
SCHEDULER_DB=/var/lib/banqi/scheduler.db

# ── R2 对象存储 ─────────────────────────────────────────────────────────────
# 桶名（R2 控制台创建）
SCHEDULER_R2_BUCKET=banqi
# R2 S3 API 凭据（R2 → API → 创建 API 令牌，权限：对象读和写）
# 注意：端点为账号限定 S3 API 域名，不带桶名路径；APAC jurisdiction 桶必须用
# 控制台桶详情页显示的端点（形如 https://<account_id>.r2.cloudflarestorage.com）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://<account_id>.r2.cloudflarestorage.com

# ── 任务调度 ────────────────────────────────────────────────────────────────
# 下发给 worker/trainer 的变体 id（4x8 / 4x4 / mini）
SCHEDULER_VARIANT=4x8
# selfplay 每次下发的局数（也是 rating 任务单批上限）
SCHEDULER_GAMES_PER_TASK=16
# 资源分配基准线程数：局数按 worker 上报线程数缩放（games = GAMES_PER_TASK × threads/基准，
# 最小 1）。0 = 不按资源缩放，每批固定 GAMES_PER_TASK
SCHEDULER_THREADS_BASELINE=4
# gatekeeper 对打目标局数（换色成对数；实际局数 = 值 × 2）
SCHEDULER_GATEKEEPER_PAIRS=400
# 课程学习：初始预翻棋子数，经 extra_config 下发给 worker（selfplay 与 rating 均生效）。
# 0 = 不下发，用变体默认值；修改后重启调度器，或在 WebUI 在线切换（在线切换的值落库后优先于本配置）
SCHEDULER_INITIAL_REVEALED=0
# 自对弈产哪类训练数据，经 SelfPlayParams.data_kind 下发：
#   resnet = Gumbel MCTS 自对弈的稠密特征（配 .onnx 权重，当前 collector 唯一支持的类别）
#   nnue   = Expectimax 强自对弈的稀疏特征（配 .nnue 权重；collector 尚未接入该采集路径，
#            设成 nnue 会让现有 collector 明确报错退出，不会静默产出别的类别）
# 同样可在 WebUI 在线切换（在线切换的值落库后优先于本配置）
SCHEDULER_DATA_KIND=resnet

# ── 局面重搜 reanalysis（可选） ─────────────────────────────────────────────
# trainer 经 SubmitReanalysis 提交历史局面快照，由 worker 用当前 best 网络重跑 MCTS
# 刷新训练目标（数据走常规 episode 上报通道）。
# 重搜与自对弈争抢同一份算力，故按间隔节流：每 N 个 selfplay 任务最多下发 1 个重搜任务。
# 0 = 关闭（SubmitReanalysis 直接拒绝，队列不积累）。建议先设 4~8 观察吞吐影响。
SCHEDULER_REANALYSIS_INTERVAL_TASKS=0
# 待下发重搜任务的队列上限（按载荷条数）：满了拒绝新提交（不丢已有条目；
# 最旧的位置恰恰是重搜收益最大的，故不按 FIFO 丢弃）
SCHEDULER_REANALYSIS_MAX_QUEUE=64

# ── 绝对强度评估（TASK_EVAL，可选；建议开启） ────────────────────────────────
# 背景：gatekeeper（上面那组 GSPRT）是**相对**门禁，只回答「这代比上代强吗」，
# 结构上测不出「所有版本都打不过一个 3 行的优先吃子启发式」。本组配置让调度器按版本
# 自动下发「best vs 规则/内建对手」的评测任务（采集端执行、只统计胜负、不产训练数据、
# 不参与晋级），结果落 eval_results 并在 WebUI「绝对强度」页 / GET /api/eval 展示。
#
# ⚠️ 默认关闭：旧版 collector 不认识 TASK_EVAL（会安全降级为「无任务」并记日志），
#    请先升级 collector 再开启。
SCHEDULER_EVAL_ENABLED=false
# 对手阶梯（逗号分隔，顺序即由弱到强展示）：random / rule:reveal_first / rule:capture_first。
# 优先吃子必须在内 —— 它是「练了很久却打不过启发式」这类问题的照妖镜。
SCHEDULER_EVAL_OPPONENTS=random,rule:reveal_first,rule:capture_first
# 每档对局数（一次任务即含全部局数，不做累加）。1000 局纯策略约 6~13s；
# 定版建议 3000 局（SE≈0.9pt），趋势观察 1000 局（SE≈1.6pt）足够。
SCHEDULER_EVAL_GAMES=1000
# 评估搜索深度：0 = 纯策略 argmax（无搜索，门禁主口径）；>0 = MCTS 模拟数（成本随其上升）
SCHEDULER_EVAL_MCTS_SIMS=0
# 节流：每 N 次 best 晋级评测一次（1 = 每次都评测）
SCHEDULER_EVAL_EVERY_N_PROMOTIONS=1
# 停机判据：同一对手的胜率序列上，连续 N 次「提升 < EPS」即置位 should_stop，
# trainer 轮询 GetInfo.should_stop 后优雅停止（先训完当前轮并落 checkpoint）。
# N=0 = 只观测不判停。
SCHEDULER_EVAL_NO_PROGRESS_N=3
# 「有提升」的最小胜率增量：0.02 = 2pt（对齐 3000 局时 2σ≈1.8pt，低于此视为抽样噪声）
SCHEDULER_EVAL_NO_PROGRESS_EPS=0.02

# ── 五项 GSPRT 判停参数 ─────────────────────────────────────────────────────
# H0：新网络 <= elo0（拒绝晋级）；H1：新网络 >= elo1（晋级 best）
SCHEDULER_SPRT_ELO0=0
SCHEDULER_SPRT_ELO1=30
# 两类错误率（越小判停所需局数越多）
SCHEDULER_SPRT_ALPHA=0.05
SCHEDULER_SPRT_BETA=0.05

# ── WebUI（只读 + 控制，默认仅本机，无鉴权） ─────────────────────────────────
# HTTP 监听地址；WebUI 启动失败只记日志，不影响 gRPC 调度
SCHEDULER_HTTP_ADDR=127.0.0.1:9536
# worker 在线判定窗口（秒）：最后心跳距今超过该值显示为离线
SCHEDULER_WORKER_ONLINE_SECONDS=60

# ── 版本管控（可选） ────────────────────────────────────────────────────────
# 设置后，client_version 低于该值的 worker 将收到 task_waiting 不派单
# SCHEDULER_MIN_CLIENT_VERSION=0.1.0
